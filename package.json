{
  "name": "fileshape",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first file format conversion tools.",
  "type": "module",
  "scripts": {
    "verify:ruby": "tsx src/verify-ruby-samples.ts",
    "diagnose:ruby": "tsx src/diagnose-ruby.ts",
    "inspect:ruby-refinement": "tsx src/ruby-refinement-inventory.ts",
    "inspect:ruby-near-miss": "tsx src/ruby-near-miss-evidence.ts",
    "inspect:ruby-glyph-selection": "tsx src/ruby-glyph-selection-evidence.ts",
    "inspect:ruby-unresolved-detail": "tsx src/ruby-unresolved-detail-evidence.ts",
    "inspect:pdf": "tsx src/pdf-inspect.ts",
    "inspect:all": "tsx src/pdf-inspect-all.ts",
    "inspect:structure": "tsx src/pdf-structure-inventory.ts",
    "inspect:outline-evidence": "tsx src/outline-source-evidence.ts",
    "inspect:images": "tsx src/pdf-image-inventory.ts",
    "inspect:image-resources": "tsx src/pdf-image-resource-inventory.ts",
    "verify:image-model": "tsx src/verify-production-image-model.ts",
    "verify:cover": "tsx src/verify-cover-policy.ts",
    "verify:cli": "tsx src/verify-cli-acceptance.ts",
    "inspect:marked-content": "tsx src/pdf-marked-content-inventory.ts",
    "inspect:runtime-deps": "tsx src/runtime-dependency-inventory.ts --write",
    "verify:runtime-deps": "tsx src/runtime-dependency-inventory.ts --verify",
    "probe:layout": "tsx src/pdf-layout-probe.ts",
    "reconstruct:page": "tsx src/pdf-reconstruct-page.ts",
    "check:flow": "tsx src/pdf-flow-check.ts",
    "compare:flow": "tsx src/pdf-flow-compare.ts",
    "diagnose:reading-order": "tsx src/diagnose-reading-order-loss.ts",
    "verify:semantic": "tsx src/verify-semantic-samples.ts",
    "verify:stage2": "tsx src/verify-stage2-corpus-v2.ts",
    "verify:n8440-oracle": "tsx src/verify-n8440-oracle.ts",
    "verify:epub": "tsx src/verify-epub-corpus.ts",
    "verify:generic-corpus": "tsx src/verify-generic-corpus-quality.ts",
    "setup:epubcheck": "tsx src/setup-epubcheck.ts",
    "verify:epubcheck": "tsx --test test/epubcheck.integration.ts",
    "fixture:reader": "tsx src/reading-system-fixture.ts",
    "diagnose:orientation": "tsx src/diagnose-unresolved-orientation.ts",
    "audit:genericity": "tsx src/audit-genericity.ts",
    "convert:epub": "tsx src/pdf-to-epub.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:browser-tests": "tsc -p tsconfig.browser-tests.json --noEmit",
    "test": "tsx src/test-runner.ts",
    "setup:browser": "playwright install chromium",
    "prepare:browser-assets": "tsx src/prepare-browser-pdfjs-assets.ts",
    "dev:browser": "npm run prepare:browser-assets && vite --config vite.config.ts",
    "build:browser": "npm run prepare:browser-assets && tsc -p tsconfig.browser.json && vite build --config vite.config.ts",
    "preview:browser": "vite preview --config vite.config.ts",
    "verify:browser-static": "node --import tsx src/verify-browser.ts",
    "verify:browser": "npm run typecheck:browser-tests && npm run build:browser && npm run verify:browser-static && playwright test --config playwright.config.ts",
    "verify:browser-private": "npm run typecheck:browser-tests && npm run build:browser && playwright test --config playwright.private.config.ts",
    "verify:local": "npm test && npm run verify:runtime-deps && npm run verify:browser && npm run setup:epubcheck && npm run verify:epubcheck && git diff --check",
    "verify:local-private": "npm run setup:epubcheck && npm run verify:ruby && npm run verify:semantic && npm run verify:stage2 && npm run verify:epub -- --epubcheck && npm run verify:generic-corpus && npm run verify:browser-private"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "7.1.5"
  }
}
